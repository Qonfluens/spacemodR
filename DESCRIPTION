Package: spacemodR
Title: Wildlife Chemical Risk Mapping Through Food Webs
Version: 0.3.5
Date: 2026-10-14
Authors@R: 
    c(person("Virgile", "Baudrot", email = "virgile.baudrot@qonfluens.com", role = c("aut", "cre", "cph")),
      person("Léa", "Bariod", email = "lea.bariod@univ-fcomte.fr", role = "aut"),
      person("Clémentine", "Fritsch", email = "clementine.fritsch@univ-fcomte.fr", role = c("aut", "cph")),
      person("Renaud", "Scheifler", email = "renaud.scheifler@univ-fcomte.fr", role = "aut"),
      person("Quentin", "Devalloir", email = "quentin.devalloir@qonfluens.com", role = "aut")
